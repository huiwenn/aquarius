index d98093f..aded4bb 100644
--- a/inference/rosvot.py
+++ b/inference/rosvot.py
@@ -160,10 +160,40 @@ def parse_args():
         action='store_true',
         help="Synchronized results saving. "
     )
+    parser.add_argument(
+        "--device",
+        type=str,
+        default='auto',
+        help="Device: auto | cuda | mps | cpu (auto = cuda > mps > cpu). "
+    )
     args = parser.parse_args()
 
     return args
 
+
+def _resolve_device(name, rank=0):
+    if name == 'auto':
+        if torch.cuda.is_available():
+            return torch.device(f"cuda:{int(rank)}")
+        if torch.backends.mps.is_available():
+            return torch.device("mps")
+        return torch.device("cpu")
+    if name == 'cuda':
+        return torch.device(f"cuda:{int(rank)}")
+    return torch.device(name)
+
+
+def _move_to(batch, device):
+    if isinstance(batch, torch.Tensor):
+        return batch.to(device)
+    if isinstance(batch, list):
+        return [_move_to(x, device) for x in batch]
+    if isinstance(batch, tuple):
+        return tuple(_move_to(x, device) for x in batch)
+    if isinstance(batch, dict):
+        return {k: _move_to(v, device) for k, v in batch.items()}
+    return batch
+
 class RosvotInfer:
     def __init__(self, num_gpus=-1):
         self.args = parse_args()
